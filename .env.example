# Public PostHog project key (phc_...), never a personal API key.
# Leave empty to disable analytics completely. Consent is required when enabled.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only. Configure real values as Sites secrets, never VITE_ variables.
DEEPSEEK_API_KEY=
AI_ENABLED=false
AI_PRIVACY_APPROVED=false
AI_MAX_REVIEWS=10

# Real values belong in Sites secrets; never paste them into chat.
# PAYMENTS_ENABLED=test requires sk_test_; live requires sk_live_.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
